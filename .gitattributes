# Menyeragamkan akhir baris agar diff tetap bersih meski dikerjakan
# bergantian di Windows, macOS, dan Linux.
* text=auto eol=lf

# Berkas biner: jangan diutak-atik Git sama sekali.
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp4   binary
*.pdf   binary

# Hasil build dan pustaka salinan ditandai sebagai berkas yang dihasilkan,
# supaya tidak memenuhi tampilan diff di GitHub saat ditinjau.
css/icons.css     linguist-generated=true
css/style.css     linguist-generated=true
css/tailwind.css  linguist-generated=true
css/bootstrap.min.css linguist-vendored=true
lib/**            linguist-vendored=true
produsen/*.html   linguist-generated=true
sitemap.xml       linguist-generated=true
_arsip-template/** linguist-vendored=true
