{
  "name": "sentra-kerupuk-ikan-besuki",
  "version": "1.0.0",
  "private": true,
  "description": "Website profil dan direktori Sentra Kerupuk Ikan Besuki, Situbondo. Program kerja KKN bidang SDGs Ekonomi.",
  "type": "module",
  "scripts": {
    "build:tailwind": "tailwindcss -i src/css/tailwind.css -o css/tailwind.css --minify",
    "build:scss": "sass src/scss/style.scss css/style.css --style=compressed --no-source-map",
    "build:pages": "node tools/build-pages.mjs",
    "build:vendor": "node tools/copy-vendor.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "build": "npm run build:vendor && npm run build:icons && npm run build:pages && npm run build:scss && npm run build:tailwind",
    "watch:tailwind": "tailwindcss -i src/css/tailwind.css -o css/tailwind.css --watch",
    "watch:scss": "sass --watch src/scss/style.scss css/style.css --no-source-map",
    "serve": "npx --yes serve . -l 3000",
    "dev": "npm run build && npm run serve"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "sass": "^1.89.2",
    "tailwindcss": "^4.1.11"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.4"
  }
}
